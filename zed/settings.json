// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "prettier": {
    "parser": "",
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "go_to_definition_fallback": "none",
  "buffer_font_family": "CaskaydiaMono Nerd Font Mono",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "base_keymap": "SublimeText",
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "buffer_font_fallbacks": ["Noto Sans", ".SystemUIFont", ".ZedMono"],
  "terminal": {
    "font_fallbacks": ["Noto Sans", ".SystemUIFont"],
  },
  "languages": {
    "YAML": {
      "format_on_save": "off",
      "formatter": "language_server",
    },
    "Ruby": {
      "language_servers": ["ruby-lsp", "!solargraph", "!rubocop", "!steep"],
    },
    // Enable herb and ruby-lsp for *.html.erb files
    "HTML+ERB": {
      "language_servers": ["herb", "ruby-lsp", "..."],
    },
    "Haml": {
      "language_servers": ["ruby-lsp", "..."],
    },
    // Enable ruby-lsp for *.js.erb files
    "JS+ERB": {
      "language_servers": ["ruby-lsp", "..."],
    },
    // Enable ruby-lsp for *.yaml.erb files
    "YAML+ERB": {
      "language_servers": ["ruby-lsp", "..."],
    },
  },
  "format_on_save": "off",
  "lsp": {
    "ruby-lsp": {
        "initialization_options": {
          "addonSettings": {
            "Ruby LSP Rails": {
              "enablePendingMigrationsPrompt": false
            }
          }
        }
      },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "format": {
            "singleQuote": false,
          },
          "schemas": {
            "https://getcomposer.org/schema.json": ["/*"],
            "../relative/path/schema.json": ["/config*.yaml"],
          },
        },
      },
    },
  },
}
